node_modules/
*.log
.DS_Store
.env
.env.*
coverage/

# Eval run outputs — results are additive and live in a store the harness
# manages. Never commit raw provider replies (they can be large and may echo
# brief text under NDA).
results/
# Sibling stores created by `--results-dir` (docs/PREREGISTRATION.md Appendix D
# item 3). The rule above predates that flag and covered only the default store,
# so a per-study store slipped past it -- results-study1/ came to 130 MB across
# 956 body files. Derived, publishable per-cell data belongs in docs/ instead
# (e.g. docs/study1-stage1a-cells.csv); the raw store stays local.
# NOTE: results-pilot/ is deliberately TRACKED (Appendix E item 8) and is not
# matched by this pattern -- it is committed history, 59 records, and removing
# it is a separate decision, not a gitignore side effect.
results-study1/
# Stage 1b's store. Listed BEFORE its first cell, not after: `results-study1/`
# is a literal, so it never matched `results-study1b/`, and the failure mode
# above is one an untracked 100 MB store reproduces in a single run.
results-study1b/
# Stage 1b's RE-RUN store (#160 / Appendix J), a fresh directory rather than a
# reuse of results-study1b/ so the defective-ceiling run stays inspectable.
# Listed here before its first cell, for the same literal-not-glob reason above.
results-study1b-r2/
# Stage 1c's store (Appendix L). Listed before its first cell, for the same
# literal-not-glob reason as every entry above.
results-study1c/
.tmp/

# Generated by scripts/derive_repo_configs.py (cwc#369)
.agents/
.codex/

# Si et al. 2024 expert-score slice — fetched locally, never redistributed here.
# Provenance: docs/fetching-si-et-al.md (evals#24). arXiv 2409.04109.
data/si-et-al/

# Merge-conflict artifacts
*.orig
*.rej

# evals/analysis/ sidecar (issue #46) — pinned Python venv, in-repo but never
# committed (see sidecar/requirements.txt), and generated run outputs.
evals/analysis/sidecar/.venv/
evals/analysis/out/
